{
  "name": "Protect main branch (Fleet Security & CI Gate)",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH",
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  " bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Automated Security & Privacy Audit (3.10)"
          },
          {
            "context": "Automated Security & Privacy Audit (3.11)"
          },
          {
            "context": "Automated Security & Privacy Audit (3.12)"
          },
          {
            "context": "Unit Tests & Coverage (80% Gate) (3.10)"
          },
          {
            "context": "Unit Tests & Coverage (80% Gate) (3.11)"
          },
          {
            "context": "Unit Tests & Coverage (80% Gate) (3.12)"
          }
        ]
      }
    }
  ],
  "rest_api_branch_protection": {
    "required_status_checks": {
      "strict": true,
      "contexts": [
        "Automated Security & Privacy Audit (3.10)",
        "Automated Security & Privacy Audit (3.11)",
        "Automated Security & Privacy Audit (3.12)",
        "Unit Tests & Coverage (80% Gate) (3.10)",
        "Unit Tests & Coverage (80% Gate) (3.11)",
        "Unit Tests & Coverage (80% Gate) (3.12)"
      ]
    },
    "enforce_admins": true,
    "required_pull_request_reviews": {
      "dismiss_stale_reviews": true,
      "require_code_owner_reviews": true,
      "required_approving_review_count": 0
    },
    "restrictions": null,
    "required_linear_history": true,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "required_conversation_resolution": true
  }
}
