{
  "name": "02 — main: Pull Request, CODEOWNERS & 12-Layer CI Security Gate",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "12-Layer Security & Python 3.10 Matrix"
          },
          {
            "context": "12-Layer Security & Python 3.11 Matrix"
          },
          {
            "context": "12-Layer Security & Python 3.12 Matrix"
          },
          {
            "context": "Test Suite (ubuntu-latest, Python 3.10)"
          },
          {
            "context": "Test Suite (ubuntu-latest, Python 3.11)"
          },
          {
            "context": "Test Suite (ubuntu-latest, Python 3.12)"
          },
          {
            "context": "Test Suite (windows-latest, Python 3.10)"
          },
          {
            "context": "Test Suite (windows-latest, Python 3.11)"
          },
          {
            "context": "Test Suite (windows-latest, Python 3.12)"
          }
        ]
      }
    }
  ]
}
