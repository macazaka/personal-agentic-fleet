# Fleet Control Center - Open Source Agentic Fleet Configuration
# Copy this file to fleet.yaml (or fleet.json) to customize your fleet.

server:
  host: "127.0.0.1"
  port: 7890
  default_agent: "health"       # Default tab opened on startup: 'health', 'overview', 'optimizer', etc.

# User Custom Agents Directory (persisted, git-ignored, and immune to git pulls)
custom_agents_dir: "fleet/data/user/custom_agents"

# Modular Plug-and-Play Agents (Customize ANY agent below)
# Supported customization keys for any agent:
#   - enabled: true/false
#   - name: "Custom Display Name"
#   - icon: "✨" (Any Emoji or SVG)
#   - order: 10 (Lower numbers appear first in dashboard navigation)
#   - is_default: true/false (Active tab on startup)
#   - provider: "auto" / "google" / "anthropic" / "microsoft" / "aws" / "ollama"
#   - model: "gemini-2.5-pro" / "claude-3-7-sonnet" / "gpt-4o" / "llama3.2"
#   - system_prompt: "Custom system instruction for this agent"
#   - custom_panel_path: "path/to/custom_panel.html" (Overrides frontend UI pane)
#   - settings: { ... } (Agent-specific custom dictionary)

agents:
  health:
    enabled: true
    name: "Health & Metabolic Command"  # Optional display name override
    icon: "🌿"                          # Optional icon override
    order: 10
    is_default: true
    videos_directory: "./data/videos"   # Customize to your local fitness folder
    reminders_enabled: true

  overview:
    enabled: true
    name: "Overview & Tasks"
    icon: "⚡"
    order: 20
    provider: "auto"                    # Route through preferred hyperscaler

  optimizer:
    enabled: true
    name: "PC Turbo Optimizer"
    icon: "🚀"
    order: 30
    scan_interval_hours: 6

  antigravity:
    enabled: true
    name: "Antigravity Live IDE Mirror"
    icon: "🤖"
    order: 40
    provider: "anthropic"               # Example: use Claude 3.7 Sonnet for code synthesis
    model: "claude-3-7-sonnet-20241022"

  backlog:
    enabled: true
    name: "Roadmap & Backlog"
    icon: "📋"
    order: 50

  gmail:
    enabled: false                      # Set to true and provide credentials to enable Gmail Intelligence
    name: "Email Intelligence"
    icon: "📬"
    order: 60
    credentials_path: "fleet/data/user/client_secret.json"

  pr_review:
    enabled: false                      # Admin-only Pull Request audit agent
    name: "Admin PR Review & CI Quality Gate"
    icon: "🛡️"
    order: 70
    repository: "macazaka/personal-agentic-fleet"
    interval_minutes: 60

# Automated Security & Privacy Scanner Configuration
security:
  scan_interval_minutes: 60             # Automatic background scan frequency in FleetDaemon
  block_commits_on_findings: true
  toast_alerts_on_findings: true

# ==============================================================================
# Automated Agent Schedules (Customizable by user in YAML or schedules.yaml)
# Built-in default schedules are automatically active if omitted.
# Customize execution time, interval, days, active hours, or enable/disable.
# ==============================================================================
schedules:
  # Customize morning briefing time to 09:00 on weekdays
  - id: overview_morning_briefing
    agent: overview
    task: morning_briefing
    description: "Daily morning briefing with top priorities"
    schedule_type: time_of_day
    time: "08:30"
    days: ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
    enabled: true
    notify: true

  # Evening reflection & wrap-up
  - id: overview_evening_review
    agent: overview
    task: evening_review
    description: "Evening review and task reflection"
    schedule_type: time_of_day
    time: "20:00"
    enabled: true
    notify: true

  # PC Optimizer frequency
  - id: optimizer_quick_optimize
    agent: optimizer
    task: quick_optimize
    description: "Periodic RAM optimization and memory check"
    schedule_type: interval
    interval_hours: 6
    enabled: true
    notify: false

  # Email intelligence pulse during working hours
  - id: gmail_sync_and_classify
    agent: gmail
    task: sync_and_classify
    description: "Bi-hourly email classification pulse during workday"
    schedule_type: interval
    interval_hours: 2
    active_hours: "08:00-18:00"
    weekdays_only: true
    enabled: false                      # Set to true when Gmail credentials are provided
    notify: false
