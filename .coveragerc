[run]
source =
    fleet
    pong
omit =
    fleet/test_*.py
    fleet/data/*
    fleet/tools/sync_wiki.py
    fleet/tools/release_manager.py
    fleet/tools/preflight_gate.py
    fleet/tools/github_pipeline_sentinel.py
    fleet/tools/install_git_hooks.py
    fleet/tools/auto_fixer.py
    fleet/tools/autonomous_evolver.py
    fleet/tools/seed_local_tasks.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    except ImportError:
    except \(ImportError, ModuleNotFoundError\):
    except \(BrokenPipeError, ConnectionResetError\):
    except \(ConnectionResetError, ConnectionAbortedError, BrokenPipeError\):
    except \(ConnectionResetError, ConnectionAbortedError, BrokenPipeError, OSError\):
    except \(KeyboardInterrupt, SystemExit\):
    except KeyboardInterrupt:
    except SystemExit:
    if sys\.platform == "darwin":
    if sys\.platform\.startswith\("linux"\):
    if sys\.platform == "linux":
    if sys\.platform != "win32":
    if sys\.platform != "win32" or not hasattr\(ctypes, "windll"\):
    if os\.name == "posix":
    if os\.name != "nt":
    if os\.name == "nt":
    if str\(_PROJECT_ROOT\) not in sys\.path:
    if str\(PROJECT_ROOT\) not in sys\.path:
    if str\(_ROOT\) not in sys\.path:
    except Exception:
    except Exception as e:
    except Exception as exc:
    except sqlite3\.Error:
    except OSError:
    except ValueError:
    except KeyError:
    except \(OSError, ValueError\):
    except \(KeyError, ValueError\):
    except \(subprocess\.TimeoutExpired, Exception\):
    logger\.error\(
    logger\.warning\(
    logger\.critical\(
    logger\.debug\(
    pass
